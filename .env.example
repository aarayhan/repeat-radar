# Copy to .env and fill in. Never commit .env.
FEATHERLESS_API_KEY=
# Optional. LLM_PROVIDER: featherless (default), openai, openrouter, ollama.
# Each provider reads its own key: OPENAI_API_KEY, OPENROUTER_API_KEY; ollama needs none.
# LLM_MODEL is required for every provider except featherless.
LLM_PROVIDER=
LLM_MODEL=
